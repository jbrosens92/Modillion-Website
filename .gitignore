# Confidential investor material — must never be committed.
# This repository is public.
*.docx
*.xlsx
*.pdf

# Local-only holding area for content pulled off the site temporarily.
.content-archive/

# Real OneDrive snapshot used to develop the Company Dashboard locally.
# Contains live deal and sponsor names — must never reach this public repo.
dashboard-data.json
dashboard-data.*.json

# Investor CRM records — real firm names, conversation notes and forwarded
# email content. Same rule as the snapshot above: never commit.
crm-data.json
crm-data.*.json
crm-inbox/

# Operator CRM records — sponsor names and the deals they run, read off the
# live folder snapshot. Same rule: never commit.
operator-data.json
operator-data.*.json

# Company task list — titles reference live deals, investors and internal
# deadlines. Same rule: never commit.
tasks-data.json
tasks-data.*.json

# Node dependencies for the /api/agent function.
node_modules/

# The local path to the OneDrive folder the dashboard mirrors. Machine-specific,
# and this repository is public — the script reads it, git does not carry it.
tools/snapshot-source.txt
